# Runtime
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:replace-with-a-local-password@localhost:5432/billing-engine
REDIS_URL=redis://localhost:6379

# Used by docker-compose.yml for the local PostgreSQL container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=billing-engine

# Daraja endpoints. Sandbox values are for local/test use.
MPESA_TOKEN_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
STK_PUSH_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
# Configure this full URL in Daraja. The final path segment must match DARAJA_CALLBACK_TOKEN.
MPESA_CALLBACK_URL=https://your-public-host/api/webhooks/daraja/callback/replace-with-the-same-callback-token
DARAJA_CALLBACK_TOKEN=replace-with-a-long-random-secret
# Local and test fallback credentials only. Production payments require merchant-provided credentials.
CONSUMER_KEY=
CONSUMER_SECRET=
SHORT_CODE=
PASSKEY=
# Generate using: openssl rand -base64 32
MPESA_CREDENTIAL_ENCRYPTION_KEY=

# Webhook destination policy. Private endpoints also require real network routing from this API host.
# Private addresses are blocked unless their exact destination CIDRs are listed here.
WEBHOOK_ALLOWED_PRIVATE_CIDRS=
# Defaults to 443. Add non-standard ports only when explicitly required by approved destinations.
WEBHOOK_ALLOWED_PORTS=443

# Cradle Voices SMS provider.
CRADLE_URL=https://merchant.cradlevoices.com/
CRADLE_TOKEN=

# Browser build setting (set when building/running web/, not used by the API container).
VITE_API_URL=http://localhost:3000/api
