// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider             = "prisma-client"
  output               = "../src/generated/prisma"
  moduleFormat         = "cjs"
  importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
}

enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  RETRYING
  PAST_DUE
  CANCELLED
}

enum PaymentAttemptStatus {
  SCHEDULED
  INITIATED
  PENDING_CONFIRMATION
  SUCCEEDED
  FAILED
  TIMED_OUT
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum MpesaSetupStatus {
  PENDING
  COMPLETED
}

model Merchant {
  id String @id @default(uuid())
  name String
  phoneNumber String? @unique
  email String? @unique
  passwordHash String?
  apiKeyId String? @unique
  apiKeyHash String @unique
  webhookUrl String?
  webhookSecret String?
  mpesaConsumerKeyEncrypted String?
  mpesaConsumerSecretEncrypted String?
  mpesaShortcode String?
  mpesaPasskeyEncrypted String?
  mpesaSetupStatus MpesaSetupStatus @default(PENDING)
  mpesaSetupCompletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans Plan[]
  subscriptions Subscription[]
  webhookDeliveries WebhookDelivery[]
}

model Plan {
  id String @id @default(uuid())
  name String
  amount Decimal @db.Decimal(12,2)
  interval BillingInterval @default(MONTHLY)
  createdAt DateTime @default(now())

  merchantId String
  merchant Merchant @relation(fields: [merchantId], references: [id])

  subscriptions Subscription[]

  @@index([merchantId])
}

model Subscription {
  id String @id @default(uuid())
  customerPhone String 
  status SubscriptionStatus @default(ACTIVE)
  nextBillingDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchantId String
  merchant Merchant @relation(fields: [merchantId], references: [id])

  planId String
  plan Plan @relation(fields: [planId], references: [id])

  paymentAttempts PaymentAttempt[]

  @@index([merchantId])
  @@index([customerPhone])
  @@index([ status, nextBillingDate])
}

model PaymentAttempt {
  id String @id @default(uuid())
  status PaymentAttemptStatus @default(SCHEDULED)
  checkoutId String? @unique
  mpesaReceiptNumber String? @unique
  mpesaTransactionDate DateTime?
  idempotencyKey String @unique
  attemptNumber Int @default(1)
  amount Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  subscriptionId String
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([status]) 
}

model DarajaCallback {
  id String @id @default(uuid())
  checkoutId String @unique
  payload Json
  receivedAt DateTime @default(now())
  processedAt DateTime?

  @@index([processedAt, receivedAt])
}

model WebhookDelivery {
  id String @id @default(uuid())
  eventType String
  payload Json
  status WebhookDeliveryStatus @default(PENDING)
  attempts Int @default(0)
  createdAt DateTime @default(now())
  deliveredAt DateTime?

  merchantId String
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([status])
}
